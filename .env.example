# Local host-run template.
# Copy this file to .env for local commands such as make migrate, make seed-taxonomy, and make tui.
BOOKSHELF_ENV=development
BOOKSHELF_API_HOST=0.0.0.0
BOOKSHELF_API_PORT=8000
BOOKSHELF_DATABASE_URL=postgresql+psycopg://bookshelf:bookshelf@localhost:5432/bookshelf
BOOKSHELF_AWS_ACCESS_KEY_ID=minioadmin
BOOKSHELF_AWS_SECRET_ACCESS_KEY=minioadmin
BOOKSHELF_S3_ENDPOINT_URL=http://localhost:9000
BOOKSHELF_S3_REGION=us-east-1
BOOKSHELF_S3_BUCKET=bookshelf-thumbnails
BOOKSHELF_S3_SECURE=false
